---
layout: base.njk
permalink: /image-rotate/
title: Rotate &amp; Flip Images — Image Tools
---

<link rel="stylesheet" href="{{ '/assets/css/image-tools.css' | url }}">

<section class="ie-page">
  <h1 class="ie-h1">Rotate &amp; Flip Images</h1>
  <p class="ie-lede">Quarter turns and mirrors for whole batches — phone photos come out upright because rotation respects the camera's orientation tag.</p>

  <div class="ie-zone" id="ie-zone" tabindex="0" role="button" aria-label="Add images: drop files here or press Enter to browse">
    <input type="file" id="ie-input" accept="image/*" multiple hidden>
    <p class="ie-zone-title">Drop images here <span class="ie-or">or click to browse</span></p>
    <p class="ie-zone-sub">JPG · PNG · WebP · GIF (first frame) · BMP — batches welcome</p>
  </div>

  <div class="ie-controls">
    <fieldset class="ie-field ie-fieldset">
      <legend>Rotate</legend>
      <label class="ie-check"><input type="radio" name="ie-angle" value="0" checked> None</label>
      <label class="ie-check"><input type="radio" name="ie-angle" value="90"> 90° clockwise</label>
      <label class="ie-check"><input type="radio" name="ie-angle" value="180"> 180°</label>
      <label class="ie-check"><input type="radio" name="ie-angle" value="270"> 270° clockwise (90° ccw)</label>
    </fieldset>
    <div class="ie-field">
      <span>Mirrors</span>
      <label class="ie-check"><input type="checkbox" id="ie-fliph"> Flip horizontal</label>
      <label class="ie-check"><input type="checkbox" id="ie-flipv"> Flip vertical</label>
    </div>
    <label class="ie-field">Output format
      <select id="ie-format">
        <option value="auto" selected>Keep each file's format</option>
        <option value="image/jpeg">JPEG</option>
        <option value="image/png">PNG</option>
        <option value="image/webp">WebP</option>
      </select>
    </label>
    <label class="ie-field">Quality — <output id="ie-quality-out">90%</output>
      <input type="range" id="ie-quality" min="0.05" max="1" step="0.05" value="0.9">
    </label>
  </div>

  <div class="ie-run">
    <button type="button" id="ie-go" class="ie-btn" disabled>Rotate / Flip</button>
    <button type="button" id="ie-clear" class="ie-btn" disabled>Clear</button>
    <button type="button" id="ie-zip" class="ie-btn" hidden>Download all (.zip)</button>
    <span class="ie-status mono" id="ie-status"></span>
  </div>

  <pre class="ie-log mono" id="ie-log" aria-live="polite"></pre>
  <div class="ie-results" id="ie-results"></div>
  <div class="ie-ziprow mono" id="ie-ziprow" hidden></div>
</section>

<script src="{{ '/assets/js/image-engine.js' | url }}"></script>
<script src="{{ '/assets/js/image-rotate.js' | url }}"></script>
