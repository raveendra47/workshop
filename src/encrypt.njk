---
layout: base.njk
title: Encrypt PDF
---
<h1>Encrypt PDF</h1>
<p class="page-note">Add a password with full-strength AES-256 (PDF 2.0 encryption). Pick a strong passphrase — there is no recovery path. Nothing is uploaded.</p>

{% set uploadId = "encrypt" %}
{% include "upload-widget.njk" %}

<div id="tool-controls" hidden>
  <p class="file-summary" id="file-summary"></p>

  <label class="range-label" for="pw1">Password</label>
  <input id="pw1" class="range-input" type="password" autocomplete="new-password">
  <label class="range-label" for="pw2">Repeat password</label>
  <input id="pw2" class="range-input" type="password" autocomplete="new-password">
  <p class="csp-sub" id="pw-note"></p>

  <button id="run-btn" class="btn" disabled>Encrypt</button>
</div>

<div id="progress-wrap" hidden>
  <div class="progress"><div class="progress-bar"></div></div>
  <p id="progress-status" role="status"></p>
</div>

<div id="dl-card" class="result-card" hidden></div>
<p id="status" role="status"></p>

<script src="/assets/vendor/idb.min.js"></script>
<script type="module" src="/assets/js/encrypt.js"></script>