---
layout: base.njk
title: Extract Pages
---
<h1>Extract pages</h1>
<p class="page-note">Pull selected pages out into a new PDF, keeping their order. Nothing is uploaded.</p>

{% set uploadId = "extract" %}
{% include "upload-widget.njk" %}

<div id="tool-controls" hidden>
  <p class="file-summary" id="file-summary"></p>
  <label class="range-label" for="ranges">Pages to extract</label>
  <input id="ranges" class="range-input" type="text" inputmode="numeric" autocomplete="off"
         placeholder="e.g. 1-3, 5, 8-10">
  <button id="run-btn" class="btn" disabled>Extract</button>
</div>

<div id="progress-wrap" hidden>
  <div class="progress"><div class="progress-bar"></div></div>
  <p id="progress-status" role="status"></p>
</div>

<div id="dl-card" class="result-card" hidden></div>
<p id="status" role="status"></p>

<script src="{{ '/assets/vendor/idb.min.js' | url }}"></script>
<script type="module" src="{{ '/assets/js/extract-pages.js' | url }}"></script>